# Your Mentio API key, from the dashboard (Settings, API keys) or POST /v1/api-keys.
# It stays on the server: nothing in this app sends it to the browser.
MENTIO_API_KEY=mk_live_...

# Optional: another Mentio deployment's host.
# MENTIO_API_URL=https://api.mentio.dev

# Recommended anywhere but localhost: sign-in with one account per workspace.
# Each account has its own email, password and Mentio API key, so its
# keywords, channels, alerts and settings are its own. Hash each password
# with `npm run hash-password -- 'the password'`. With AUTH_ACCOUNTS set,
# MENTIO_API_KEY is not used. Unset, the app is open and anyone who can open
# it acts with MENTIO_API_KEY's workspace.
# AUTH_ACCOUNTS='[{"id":"campana-a","name":"Campaña A","email":"a@example.com","password":"scrypt:...","apiKey":"mk_live_..."}]'

# Required with AUTH_ACCOUNTS: signs and encrypts the session cookie.
# Generate one with `openssl rand -base64 32`; changing it signs everyone out.
# AUTH_SECRET=
