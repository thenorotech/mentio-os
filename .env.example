# Your Mentio API key, from the dashboard (Settings, API keys) or POST /v1/api-keys.
# It stays on the server: nothing in this app sends it to the browser.
MENTIO_API_KEY=mk_live_...

# Optional: another Mentio deployment's host.
# MENTIO_API_URL=https://api.mentio.dev

# Recommended anywhere but localhost: sign-in with accounts in Postgres.
# Each account registers at /register with an email and password; all of
# them work on MENTIO_API_KEY's workspace. Unset, the app is open to anyone
# who can open it. `npm run build` runs
# `prisma db push` against it; `npm run db:push` does it by hand.
# DATABASE_URL=postgresql://user:password@host:5432/agora

# Required with DATABASE_URL: signs the session cookie.
# Generate one with `openssl rand -base64 32`. Changing it signs everyone out.
# AUTH_SECRET=

# Optional: Apify, for the "Redes y web" pages (Instagram, Facebook, X, TikTok,
# YouTube, Google and Google News). A token from console.apify.com
# (Settings, API & Integrations). It stays on the server like the Mentio key.
# APIFY_TOKEN=apify_api_...
# Optional: cap what one run may charge (USD), and the country/language for Google and news.
# APIFY_MAX_USD_PER_RUN=1
# APIFY_COUNTRY=mx
# APIFY_LANGUAGE=es
# Optional: another actor for a source, APIFY_ACTOR_<INSTAGRAM|FACEBOOK|X|TIKTOK|YOUTUBE|GOOGLE|NEWS>=user/actor
# APIFY_ACTOR_NEWS=lhotanova/google-news-scraper
# The campaign's time zone for days and hours in those charts.
# DASHBOARD_TIMEZONE=America/Mexico_City
