// The app's own data. Everything else (keywords, channels, alerts, settings)
// lives in the Mentio workspace of MENTIO_API_KEY and is read through the API.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One dashboard login.
model Account {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// scrypt:<salt hex>:<hash hex>
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
